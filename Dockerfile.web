# Frontend Vue 3 : build Vite, puis service des fichiers statiques par nginx.
# nginx fait aussi office de reverse proxy vers l'API, ce qui permet a
# src/config.js de garder des URLs relatives en production (meme origine,
# donc pas de CORS et pas d'URL d'API a recompiler par environnement).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
