# Backend Express (proxy Spotify + etat de la file d'attente).
FROM node:22-alpine

WORKDIR /app

# Les dependances d'abord : cette couche n'est reconstruite que si les
# manifestes changent, pas a chaque modification du code.
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

COPY server/index.js ./

# Les jetons Spotify sont ecrits sur disque pour survivre a un redemarrage.
# /app appartient a root et n'est pas inscriptible par l'utilisateur node ;
# on prevoit donc un repertoire dedie, monte sur un volume par le compose.
RUN mkdir -p /data && chown node:node /data
ENV TOKENS_FILE=/data/tokens.json
# Le jeton de session hote survit lui aussi au redeploiement : sans cela, une
# mise en ligne coupe la session de l'app voiture en pleine route.
ENV HOST_FILE=/data/host.json

# L'etat de la session (file d'attente, votes, heartbeats) reste en memoire :
# une seule instance, pas de scaling horizontal sans refonte.
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

USER node

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "index.js"]
